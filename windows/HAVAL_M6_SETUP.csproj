<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>assets\HAVAL_M6_SETUP.ico</ApplicationIcon>
    <AssemblyName>HAVAL_M6_SETUP</AssemblyName>
    <RootNamespace>HavalM6Setup</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="assets\adb.exe" LogicalName="HAVAL_M6_SETUP.adb.exe" />
    <EmbeddedResource Include="assets\AdbWinApi.dll" LogicalName="HAVAL_M6_SETUP.AdbWinApi.dll" />
    <EmbeddedResource Include="assets\AdbWinUsbApi.dll" LogicalName="HAVAL_M6_SETUP.AdbWinUsbApi.dll" />
    <EmbeddedResource Include="assets\havalm6-launcher.apk" LogicalName="HAVAL_M6_SETUP.havalm6-launcher.apk" />
    <EmbeddedResource Include="assets\YandexMusicLite-v1.14.8.apk" LogicalName="HAVAL_M6_SETUP.YandexMusicLite-v1.14.8.apk" />
    <EmbeddedResource Include="assets\SHA256SUMS.txt" LogicalName="HAVAL_M6_SETUP.SHA256SUMS.txt" />
  </ItemGroup>
</Project>
